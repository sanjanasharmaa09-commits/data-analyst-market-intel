   "source": [
    "import pandas as pd\n",
    "import ast\n",
    "from collections import Counter\n",
    "from itertools import combinations\n",
    "\n",
    "df = pd.read_csv(r\"cleaned_jobs_final.csv\")\n",
    "df[\"clean_skills\"] = df[\"clean_skills\"].apply(lambda x: ast.literal_eval(x) if pd.notnull(x) else [])\n",
    "\n",
    "# ============================================\n",
    "# ANALYSIS 1: Sabse zyada demand wali skills\n",
    "# ============================================\n",
    "all_skills = []\n",
    "for tags in df[\"clean_skills\"]:\n",
    "    all_skills.extend(tags)\n",
    "\n",
    "skill_counts = Counter(all_skills)\n",
    "top_skills = pd.DataFrame(skill_counts.most_common(20), columns=[\"Skill\", \"Count\"])\n",
    "print(\"=== Top 20 Most In-Demand Skills ===\")\n",
    "print(top_skills)\n",
    "\n",
    "# ============================================\n",
    "# ANALYSIS 2: Location-wise job distribution\n",
    "# ============================================\n",
    "print(\"\\n=== Top 10 Hiring Locations ===\")\n",
    "print(df[\"primary_location\"].value_counts().head(10))\n",
    "\n",
    "# ============================================\n",
    "# ANALYSIS 3: Experience level distribution\n",
    "# ============================================\n",
    "print(\"\\n=== Experience Bucket Distribution ===\")\n",
    "print(df[\"experience_bucket\"].value_counts())\n",
    "\n",
    "# ============================================\n",
    "# ANALYSIS 4: Salary insights\n",
    "# ============================================\n",
    "print(\"\\n=== Average Salary by Experience Level ===\")\n",
    "print(df.groupby(\"experience_bucket\")[\"salary_avg\"].mean().round(2))\n",
    "\n",
    "print(\"\\n=== Top Paying Locations (avg salary) ===\")\n",
    "print(df.groupby(\"primary_location\")[\"salary_avg\"].mean().sort_values(ascending=False).head(10))\n",
    "\n",
    "# ============================================\n",
    "# ANALYSIS 5: Skill vs Average Salary (Sabse Impressive Insight)\n",
    "# ============================================\n",
    "skill_salary = {}\n",
    "for skill in skill_counts.keys():\n",
    "    matching_jobs = df[df[\"clean_skills\"].apply(lambda x: skill in x)]\n",
    "    if len(matching_jobs) > 0:\n",
    "        skill_salary[skill] = matching_jobs[\"salary_avg\"].mean()\n",
    "\n",
    "skill_salary_df = pd.DataFrame(skill_salary.items(), columns=[\"Skill\", \"Avg_Salary\"]).sort_values(\"Avg_Salary\", ascending=False)\n",
    "print(\"\\n=== Skills Associated with Highest Average Salary ===\")\n",
    "print(skill_salary_df.head(10))\n",
    "\n",
    "# ============================================\n",
    "# ANALYSIS 6: Skill co-occurrence (pairs)\n",
    "# ============================================\n",
    "pair_counts = Counter()\n",
    "for tags in df[\"clean_skills\"]:\n",
    "    unique_tags = list(set(tags))\n",
    "    for pair in combinations(sorted(unique_tags), 2):\n",
    "        pair_counts[pair] += 1\n",
    "\n",
    "pairs_df = pd.DataFrame(\n",
    "    [(pair[0], pair[1], count) for pair, count in pair_counts.most_common(20)],\n",
    "    columns=[\"Skill_1\", \"Skill_2\", \"Count\"]\n",
    ")\n",
    "print(\"\\n=== Top 20 Skill Combinations ===\")\n",
    "print(pairs_df)\n",
    "\n",
    "# ============================================\n",
    "# ANALYSIS 7: Company tier comparison\n",
    "# ============================================\n",
    "print(\"\\n=== MNC vs Other Companies — Job Count ===\")\n",
    "print(df[\"company_tier\"].value_counts())\n",
    "\n",
    "# ============================================\n",
    "# Save All Analysis Outputs (for Power BI)\n",
    "# ============================================\n",
    "folder = r\"datanalystproject\"\n",
    "\n",
    "df.to_csv(f\"{folder}\\\\analysis_ready_final.csv\", index=False)\n",
    "top_skills.to_csv(f\"{folder}\\\\top_skills.csv\", index=False)\n",
    "pairs_df.to_csv(f\"{folder}\\\\skill_pairs.csv\", index=False)\n",
    "skill_salary_df.to_csv(f\"{folder}\\\\skill_salary.csv\", index=False)\n",
    "\n",
    "print(\"\\n✅ All analysis files saved successfully!\")\n",
    "print(\"Files created: analysis_ready_final.csv, top_skills.csv, skill_pairs.csv, skill_salary.csv\")"
   ]
